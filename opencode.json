{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "sfcc-coder": {
          "name": "SFCC-Coder (Qwen3-Coder-Next 80B)",
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    }
  },
  "model": "ollama/sfcc-coder",
  "mcp": {
    "sfcc-dev": {
      "type": "local",
      "command": ["npx", "-y", "sfcc-dev-mcp"],
      "enabled": true
    }
  }
}
